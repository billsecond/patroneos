#!/bin/sh
set -e

if [ "$1" = configure ]; then
    # Accounts in this group may sign in over Remote Desktop.
    if ! getent group remote-desktop > /dev/null; then
        addgroup --system --quiet remote-desktop
    fi
    # The proxy's own account; it can ask the sign-in helper, nothing more.
    if ! getent passwd patrone-rdp > /dev/null; then
        adduser --system --quiet --group --no-create-home \
            --home /var/lib/patrone-remote-desktop/proxy patrone-rdp
    fi
    # Hyper-V's enhanced session: its proxy and login screen run as this
    # account, which can ask the sign-in helper for that, nothing more.
    if ! getent passwd patrone-vmconnect > /dev/null; then
        adduser --system --quiet --group --no-create-home \
            --home /var/lib/patrone-remote-desktop/vmconnect patrone-vmconnect
    fi
    # The PAM hook that keeps the password hash NLA checks current
    pam-auth-update --package
fi

#DEBHELPER#

# systemd reads the changed unit files, and the drop-in for GDM's headless
# session unit. (Don't name debhelper's placeholder in a comment: debhelper
# replaces it wherever it appears.)
if [ "$1" = configure ] && [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload > /dev/null || true
fi

# GDM's settings, which turn on the login screen's extension, are compiled
# from /usr/share/gdm/dconf each time GDM starts. Until then, a login screen
# started after an upgrade would read the old ones: since 0.5.5 renamed the
# extension, it found none, and signing in on the screen offered to end the
# account's desktop. So compile them now, as GDM's own reload does. A login
# screen already showing keeps the settings it started with.
if [ "$1" = configure ] && [ -x /usr/share/gdm/generate-config ] && [ -d /run/systemd/system ]; then
    /usr/share/gdm/generate-config || true
fi

# The desktops (patrone-remote-desktop desktops on|off): each account's one
# desktop, which the login screen's Patrone Desktop session shows. On
# PatroneOS from the start; installed on its own, off until Remote Desktop
# is turned on, so installing it changes nothing. Before 0.6.0 they were
# always on: an upgrade keeps them where they're used (PatroneOS, Remote
# Desktop or Hyper-V's enhanced session turned on), and gives the login
# screen its usual sessions back elsewhere. With them on, the files they
# put in place are put there again, as this version has them.
flag=/var/lib/patrone-remote-desktop/desktops-on
command=/usr/sbin/patrone-remote-desktop
patroneos() {
    [ -e /usr/libexec/patrone-desktop/make-session-mode ]
}
in_use() {
    [ -d /run/systemd/system ] || return 1
    for unit in patrone-remote-desktop-auth.socket patrone-remote-desktop.service \
        patrone-remote-desktop-vmconnect.service; do
        systemctl is-enabled --quiet "$unit" 2> /dev/null && return 0
    done
    return 1
}
if [ "$1" = configure ]; then
    if [ -e "$flag" ]; then
        "$command" desktops on --quiet > /dev/null
    elif [ -z "$2" ]; then
        if patroneos; then
            "$command" desktops on --quiet > /dev/null
        fi
    elif dpkg --compare-versions "$2" lt 0.6.0~; then
        if patroneos || in_use; then
            "$command" desktops on --quiet > /dev/null
        else
            "$command" desktops off --quiet > /dev/null
        fi
    fi
fi
# (not when an administrator turned them off by hand: desktops-off)
if [ "$1" = triggered ] && patroneos && [ ! -e "$flag" ] &&
    [ ! -e /var/lib/patrone-remote-desktop/desktops-off ]; then
    "$command" desktops on --quiet > /dev/null
fi

# On an upgrade, debhelper has stopped Remote Desktop (and was told not to
# start it, since it's off until enabled), so start it again, with the new
# plugin, if an administrator turned it on.
if [ "$1" = configure ] && [ -n "$2" ] && [ -d /run/systemd/system ]; then
    for unit in patrone-remote-desktop-auth.socket patrone-remote-desktop.service; do
        if systemctl is-enabled --quiet "$unit"; then
            deb-systemd-invoke restart "$unit" || true
        fi
    done
fi
