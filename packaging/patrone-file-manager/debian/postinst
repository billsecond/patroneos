#!/bin/sh
# Before 0.3.11 this package retired GNOME's Files (Nautilus) itself, by
# diverting its menu entry and its FileManager1 D-Bus service. That's
# PatroneOS's choice, not the file manager's, so patrone-default-apps does
# it now, and this package installed on its own leaves Nautilus as it is.
# Diversions this package still holds go back to Nautilus here; when
# patrone-default-apps is installed, its preinst has taken them already, or
# takes them again when it's unpacked.
set -e

diverted="
/usr/share/applications/org.gnome.Nautilus.desktop
/usr/share/dbus-1/services/org.freedesktop.FileManager1.service
"

if [ "$1" = configure ]; then
    for file in $diverted; do
        if [ "$(dpkg-divert --listpackage "$file")" = patrone-file-manager ]; then
            dpkg-divert --package patrone-file-manager --remove --rename --divert "$file.nautilus" "$file"
        fi
    done
fi

#DEBHELPER#
