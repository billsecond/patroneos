#!/bin/sh
# Puts back Nautilus's files if this package still holds their diversions:
# only a version before 0.3.11 made them, and postinst hands them back
# (patrone-default-apps holds them on PatroneOS now).
set -e

diverted="
/usr/share/applications/org.gnome.Nautilus.desktop
/usr/share/dbus-1/services/org.freedesktop.FileManager1.service
"

case "$1" in
    remove | abort-install | disappear)
        for file in $diverted; do
            if [ "$(dpkg-divert --listpackage "$file")" = patrone-file-manager ]; then
                dpkg-divert --package patrone-file-manager --remove --rename --divert "$file.nautilus" "$file"
            fi
        done
        ;;
esac

#DEBHELPER#
