#!/bin/sh
set -e

#DEBHELPER#

# Before 0.2.5 this package gave Ctrl+Shift+Esc through Patrone's dconf
# database (/etc/dconf/db/patrone.d) and its profile. That's PatroneOS's
# choice, so patrone-desktop does it now, and the task manager installed on
# its own changes no settings. Once the old keyfile is gone (above, from
# the maintscript), compile what's left, or take the compiled database away
# if nothing is.
if [ "$1" = configure ] && dpkg --compare-versions "$2" lt-nl 0.2.5~; then
    if [ -n "$(ls -A /etc/dconf/db/patrone.d 2> /dev/null)" ]; then
        if command -v dconf > /dev/null; then
            dconf update || true
        fi
    else
        rm -f /etc/dconf/db/patrone
        rmdir /etc/dconf/db/patrone.d 2> /dev/null || true
    fi
fi
