#!/bin/bash
# Turns Patrone's Remote Desktop on or off.
#
#   patrone-remote-desktop enable    start it, now and at every boot (and
#                                    turn on the desktops, below)
#   patrone-remote-desktop disable   stop it (and, except on PatroneOS or
#                                    with Hyper-V's enhanced session on,
#                                    turn off the desktops)
#   patrone-remote-desktop status    whether it's on, and who may sign in
#   patrone-remote-desktop desktops on|off|status
#                                    one desktop per account: the login
#                                    screen's only session is Patrone
#                                    Desktop, which shows the account's one
#                                    desktop, the same one Remote Desktop and
#                                    Hyper-V's enhanced session show. On
#                                    PatroneOS from the start; elsewhere off,
#                                    so installing this package changes
#                                    nothing until Remote Desktop is turned on
#   patrone-remote-desktop rdp-file [HOST] > NAME.rdp
#                                    a Remote Desktop Connection file for this
#                                    computer, to double-click on Windows
#
# Accounts in the remote-desktop group sign in with their own username and
# password, checked each time: sudo adduser NAME remote-desktop
set -euo pipefail

state=/var/lib/patrone-remote-desktop/proxy
units=(patrone-remote-desktop-auth.socket patrone-remote-desktop.service)
vmconnect=patrone-remote-desktop-vmconnect.service

# The desktops. The flag says they're on: the polkit rule, the login
# screen's extension, the screen-lock autostart and the enhanced session's
# service each check it, and do nothing without it.
flag=/var/lib/patrone-remote-desktop/desktops-on
# An administrator turned them off by hand: PatroneOS's desktop arriving or
# updating doesn't turn them on again (postinst)
off_by_hand=/var/lib/patrone-remote-desktop/desktops-off
sessions=/usr/share/wayland-sessions
session_file=/usr/share/patrone-remote-desktop/gnome.desktop
headless_dropin=/etc/systemd/system/gnome-headless-session@.service.d/patrone-static-user.conf

need_root() {
    if [[ $EUID -ne 0 ]]; then
        echo "Run this with sudo." >&2
        exit 1
    fi
}

members() {
    local list
    list=$(getent group remote-desktop | cut -d: -f4)
    echo "${list:-nobody yet}"
}

# The certificate Remote Desktop clients see, made once
make_certificate() {
    install -d -o patrone-rdp -g patrone-rdp -m 700 "$state"
    if [[ ! -f $state/tls.crt ]]; then
        openssl req -x509 -newkey rsa:3072 -nodes -days 3650 -quiet \
            -subj "/CN=$(hostname)" -keyout "$state/tls.key" -out "$state/tls.crt"
        chown patrone-rdp:patrone-rdp "$state/tls.key" "$state/tls.crt"
        chmod 600 "$state/tls.key"
    fi
}

# PatroneOS's desktop (patrone-desktop) is installed
on_patroneos() {
    [[ -e /usr/libexec/patrone-desktop/make-session-mode ]]
}

daemon_reload() {
    if [[ -d /run/systemd/system ]]; then
        systemctl daemon-reload || true
    fi
}

desktops_on() {
    install -d -m 755 "$(dirname "$flag")"
    : > "$flag"
    rm -f "$off_by_hand"
    # Ubuntu's sessions leave the login screen: a plain GNOME session started
    # on the screen would end the account's desktop. Patrone Desktop is
    # gnome.desktop, the session GDM falls back to; any other package's
    # gnome.desktop is moved aside too. (A maintainer script of this package,
    # or root, may move them; dpkg puts each package's updates to them
    # beside, as *.patrone-hidden.)
    local session
    for session in ubuntu gnome; do
        dpkg-divert --package patrone-remote-desktop --add --rename --quiet \
            --divert "$sessions/$session.desktop.patrone-hidden" "$sessions/$session.desktop"
    done
    install -m 644 "$session_file" "$sessions/gnome.desktop"
    # Ubuntu bug 2171951: GDM's headless sessions never start without this
    # (data/gnome-headless-session-static-user.conf)
    install -D -m 644 /usr/share/patrone-remote-desktop/gnome-headless-session-static-user.conf \
        "$headless_dropin"
    daemon_reload
    # The PAM hook: the NLA password hash at each password sign-in, and the
    # account's desktop at a sign-in on the screen
    pam-auth-update --package --enable patrone-remote-desktop
}

desktops_off() {
    systemctl disable --now "${units[@]}" "$vmconnect" 2> /dev/null || true
    pam-auth-update --package --disable patrone-remote-desktop
    rm -f "$headless_dropin"
    rmdir --ignore-fail-on-non-empty "$(dirname "$headless_dropin")" 2> /dev/null || true
    daemon_reload
    # Patrone Desktop's gnome.desktop, only where this package moved the
    # other one aside (otherwise it's that package's own)
    if [[ $(dpkg-divert --listpackage "$sessions/gnome.desktop") == patrone-remote-desktop ]]; then
        rm -f "$sessions/gnome.desktop"
    fi
    local session
    for session in ubuntu gnome; do
        dpkg-divert --package patrone-remote-desktop --remove --rename --quiet \
            --divert "$sessions/$session.desktop.patrone-hidden" "$sessions/$session.desktop"
    done
    rm -f "$flag"
}

desktops_status() {
    if [[ -e $flag ]]; then
        echo "The desktops are on: each account has one desktop, on the screen and remotely."
    else
        echo "The desktops are off: the login screen has its usual sessions."
    fi
}

case ${1:-} in
    desktops)
        case ${2:-} in
            on)
                need_root
                was_on=; [[ -e $flag ]] && was_on=1
                desktops_on
                desktops_status
                if [[ -z $was_on && ${3:-} != --quiet ]]; then
                    echo "The login screen shows Patrone Desktop from its next start (restart the computer)."
                fi
                ;;
            off)
                need_root
                was_on=; [[ -e $flag ]] && was_on=1
                desktops_off
                # --quiet is postinst's; without it, an administrator's choice
                if [[ ${3:-} != --quiet ]]; then
                    install -d -m 755 "$(dirname "$off_by_hand")"
                    : > "$off_by_hand"
                fi
                desktops_status
                if [[ -n $was_on && ${3:-} != --quiet ]]; then
                    echo "Remote Desktop and Hyper-V's enhanced session are off too."
                    echo "The login screen has its usual sessions from its next start (restart the computer)."
                fi
                ;;
            status | "")
                desktops_status
                ;;
            *)
                echo "Usage: patrone-remote-desktop desktops on|off|status" >&2
                exit 1
                ;;
        esac
        ;;
    enable)
        need_root
        if [[ ! -e $flag ]]; then
            desktops_on
            echo "Each account now has one desktop, on the screen and remotely: the login"
            echo "screen shows Patrone Desktop from its next start (restart the computer)."
        fi
        make_certificate
        # GNOME's own Remote Login daemon would hold port 3389.
        systemctl disable --now gnome-remote-desktop.service 2> /dev/null || true
        systemctl enable --now "${units[@]}"
        echo "Remote Desktop is on, on port 3389."
        echo "Who may sign in (the remote-desktop group): $(members)"
        echo "To let an account sign in: sudo adduser NAME remote-desktop"
        echo "Each account can connect after its next password sign-in on this"
        echo "computer (or password change), which records what NLA checks."
        ;;
    disable)
        need_root
        systemctl disable --now "${units[@]}"
        echo "Remote Desktop is off."
        # Installed on its own, Remote Desktop is what the desktops are for;
        # Hyper-V's enhanced session uses them too
        if [[ -e $flag ]] && ! on_patroneos && ! systemctl is-enabled --quiet "$vmconnect" 2> /dev/null; then
            desktops_off
            echo "The login screen has its usual sessions from its next start (restart the computer)."
        fi
        ;;
    status)
        if systemctl is-active --quiet patrone-remote-desktop.service; then
            echo "Remote Desktop is on, on port 3389."
        else
            echo "Remote Desktop is off."
        fi
        echo "Who may sign in (the remote-desktop group): $(members)"
        desktops_status
        ;;
    rdp-file)
        # Plain Remote Desktop Connection works; the file only fills in the
        # computer and username, full screen, and resizing with the window.
        # Windows reads these files with CRLF line ends.
        host=${2:-$(hostname).local}
        printf '%s\r\n' \
            "full address:s:$host" \
            "username:s:${SUDO_USER:-$USER}" \
            "authentication level:i:2" \
            "screen mode id:i:2" \
            "dynamic resolution:i:1" \
            "redirectclipboard:i:1" \
            "audiomode:i:0"
        ;;
    *)
        echo "Usage: patrone-remote-desktop enable|disable|status|desktops on|off|status|rdp-file [HOST]" >&2
        exit 1
        ;;
esac
